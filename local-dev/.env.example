# 复制为 local-dev/.env 后填写本机测试后台地址。
# local-dev/.env 已被 local-dev/.gitignore 忽略，不要提交真实后台地址、token 或密码。

# 本地前端预览端口。统一默认 7003。
AICODEX_ADMIN_FRONTEND_PORT=7003

# 远端测试后台基础地址，只写 scheme/host/port，不带 /api 路径。
AICODEX_ADMIN_DEV_PROXY_TARGET=http://<60-test-backend>:18080

# 启动前用于确认后台返回 JSON 的轻量接口。
AICODEX_ADMIN_BACKEND_HEALTH_PATH=/api/get-account

# 可选：等待本地前端启动的秒数。
AICODEX_ADMIN_FRONTEND_WAIT_SECONDS=120

# 可选：logs 命令默认 tail 行数。
AICODEX_ADMIN_LOG_TAIL=120
