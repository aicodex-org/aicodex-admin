  "scripts": {
    "start": "vite",
    "prebuild": "yarn public-scripts:build",
    "build": "vite build",
    "test": "cross-env BABEL_ENV=test NODE_ENV=test PUBLIC_URL= jest --watch",
    "test:ci": "cross-env BABEL_ENV=test NODE_ENV=test PUBLIC_URL= CI=true jest --watchAll=false --runInBand --silent",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "typecheck": "tsc --noEmit",
    "typecheck:build-tooling": "tsc -p tsconfig.build-tooling.json",
    "typecheck:e2e": "tsc -p playwright/tsconfig.json --noEmit",
    "public-scripts:check": "tsc -p tsconfig.public-scripts.json --noEmit",
    "public-scripts:build": "tsc -p tsconfig.public-scripts.json",
    "public-scripts:smoke": "node public-scripts/smoke-public-auth-scripts.mjs",
    "crowdin:sync": "crowdin upload && crowdin download",
    "preinstall": "node -e \"if (process.env.npm_execpath.indexOf('yarn') === -1) throw new Error('Use yarn for installing: https://yarnpkg.com/en/docs/install')\"",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --ignore-pattern **/*.test.* --max-warnings=0",
    "fix": "eslint --fix src/**/*.{js,jsx,ts,tsx}",
    "lint:css": "stylelint src/**/*.{css,less} --fix"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.18.13",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/preset-env": "7.22.5",
    "@babel/preset-react": "^7.18.6",
    "@babel/preset-typescript": "^7.16.0",
    "@jest/globals": "27.5.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^9.3.2",
    "@testing-library/user-event": "^7.1.2",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@vitejs/plugin-react": "6.0.3",
    "babel-jest": "27.5.1",
    "babel-preset-react-app": "10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "8.22.0",
    "eslint-plugin-react": "^7.31.1",
    "eslint-plugin-unused-imports": "^2.0.0",
    "husky": "^4.3.8",
    "identity-obj-proxy": "3.0.0",
    "jest": "27.5.1",
    "jest-environment-jsdom": "27.5.1",
    "jest-watch-typeahead": "1.1.0",
    "less": "4.6.7",
    "lint-staged": "^13.0.3",
    "postcss-less": "^6.0.0",
    "stylelint": "^14.11.0",
    "stylelint-config-recommended-less": "^1.0.4",
    "stylelint-config-standard": "^28.0.0",
    "typescript": "5.7.3",
    "vite": "8.1.4"
  },
  "lint-staged": {
    "src/**/*.{css,less}": [
      "stylelint --fix"
    ],
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
