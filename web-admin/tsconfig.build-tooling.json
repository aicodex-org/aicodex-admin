{
  "compilerOptions": {
    "allowJs": false,
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "config/vitest/**/*.ts",
    "config/vitest/**/*.tsx",
    "src/vite-env.d.ts",
    "src/config/runtimeEnv.ts"
  ]
}
